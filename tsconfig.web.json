{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"baseUrl": "./src/renderer",
		"paths": {
			"@/*": ["./*"]
		},
		"outDir": "./out-tsc/web"
	},
	"include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/test/**/*.ts"]
}
