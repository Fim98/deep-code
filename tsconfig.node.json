{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"types": ["electron-vite/node"],
		"outDir": "./out-tsc/node"
	},
	"include": [
		"src/main/**/*.ts",
		"src/preload/**/*.ts",
		"electron.vite.config.ts",
		"electron-builder.config.ts"
	]
}
