{
	"name": "deepcode",
	"private": true,
	"version": "0.0.1",
	"description": "Apple Music style Electron desktop client for the pi coding agent",
	"author": "deepcode contributors",
	"license": "MIT",
	"homepage": "https://github.com/Fim98/deep-code#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fim98/deep-code.git"
	},
	"bugs": {
		"url": "https://github.com/Fim98/deep-code/issues"
	},
	"keywords": [
		"electron",
		"ai",
		"coding-agent",
		"desktop",
		"pi",
		"deepcode"
	],
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"package": "npm run build && electron-builder --config electron-builder.config.ts",
		"package:mac": "npm run build && electron-builder --mac --config electron-builder.config.ts",
		"package:mac:x64": "npm run build && electron-builder --mac --x64 --config electron-builder.config.ts",
		"package:mac:arm64": "npm run build && electron-builder --mac --arm64 --config electron-builder.config.ts",
		"package:win": "npm run build && electron-builder --win --config electron-builder.config.ts",
		"package:win:x64": "npm run build && electron-builder --win --x64 --config electron-builder.config.ts",
		"package:win:arm64": "npm run build && electron-builder --win --arm64 --config electron-builder.config.ts",
		"package:linux": "npm run build && electron-builder --linux --config electron-builder.config.ts",
		"package:linux:x64": "npm run build && electron-builder --linux --x64 --config electron-builder.config.ts",
		"package:linux:arm64": "npm run build && electron-builder --linux --arm64 --config electron-builder.config.ts",
		"preview": "electron-vite preview",
		"typecheck": "tsc -b",
		"test": "npm run test:node && npm run test:web",
		"test:node": "vitest run --config vitest.config.node.ts",
		"test:web": "vitest run --config vitest.config.web.ts",
		"test:watch": "vitest --config vitest.config.node.ts & vitest --config vitest.config.web.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome lint .",
		"check:write": "biome check --write .",
		"check:staged": "biome check --staged",
		"prepare": "husky"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.76.0",
		"@earendil-works/pi-ai": "^0.76.0",
		"@earendil-works/pi-coding-agent": "^0.76.0",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@sentry/electron": "^7.13.0",
		"@streamdown/code": "^1.1.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"ai": "6.0.191",
		"class-variance-authority": "^0.7.1",
		"clsx": "2.1.1",
		"electron-store": "10.0.1",
		"electron-updater": "^6.8.3",
		"lucide-react": "0.479.0",
		"motion": "12.40.0",
		"nanoid": "3.3.12",
		"node-pty": "^1.1.0",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"shiki": "4.1.0",
		"sonner": "^2.0.7",
		"streamdown": "2.5.0",
		"tailwind-merge": "3.0.2",
		"tailwind-variants": "^3.2.2",
		"typebox": "1.1.38",
		"zustand": "5.0.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@electron/rebuild": "^4.0.4",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "19.0.10",
		"@types/react-dom": "19.0.4",
		"@vitejs/plugin-react": "4.3.4",
		"autoprefixer": "10.4.21",
		"electron": "^41.7.1",
		"electron-builder": "^26.8.1",
		"electron-vite": "3.0.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"postcss": "8.5.15",
		"tailwindcss": "^4.3.0",
		"typescript": "5.9.3",
		"vite": "6.2.0",
		"vitest": "^4.1.7"
	}
}
